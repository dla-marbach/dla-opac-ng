{
  "postCreateCommand": "bash .devcontainer/startup.sh",
  "postStartCommand": "task start",
  "forwardPorts": [80, 3306],
  "portsAttributes": {
    "80": {
      "label": "TYPO3"
    },
    "3306": {
      "label": "mariadb"
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "dla-marbach/dla-opac-tests": {
          "permissions": "write-all"
        }
      }
    }
  }
}
