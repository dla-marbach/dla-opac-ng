{
  "name": "dla-opac-ng",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
  },
  "postCreateCommand": "bash .devcontainer/startup.sh",
  "postStartCommand": "task start",
  "forwardPorts": [80, 3306],
  "portsAttributes": {
    "80": {
      "label": "TYPO3"
    },
    "3306": {
      "label": "mariadb"
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "dla-marbach/dla-opac-tests": {
          "permissions": "write-all"
        }
      }
    },
    "vscode": {
      "extensions": []
    }
  }
}
